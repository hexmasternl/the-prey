<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens and game state must not be restored onto another device. Everything is excluded,
     including the DataStore files profile, location_consent, tracking (in-game tracking session), pending_invite, hints (first-time tours)
     and display_preferences (keep screen on during a game). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
