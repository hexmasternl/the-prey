    <string name="tag_sheet_no_longer_taggable">Die prooi kan niet meer worden getagd. De lijst is weer bijgewerkt.</string>
    <string name="tag_sheet_refresh">Vernieuwen</string>
    <string name="tag_sheet_confirm">Prooi taggen</string>
    <string name="tag_sheet_tagging">Taggen</string>
    <string name="tag_sheet_tagged">%1$s getagd</string>

    <!-- Eerste-keer-rondleidingen: gedeelde knoppen -->
    <string name="tour_skip">Overslaan</string>
    <string name="tour_back">Terug</string>
    <string name="tour_next">Volgende</string>
    <string name="tour_done">Klaar</string>
    <string name="tour_counter">%1$d / %2$d</string>
    <string name="tour_a11y_pane">Rondleiding, stap %1$d van %2$d: %3$s</string>

    <!-- Eerste-keer-rondleiding: speelveldgebied -->
    <string name="tour_area_intro_title">Je speelgebied</string>
    <string name="tour_area_intro_body">Het spel wordt binnen deze omtrek gespeeld. Teken hem rond de straten en parken die je wilt gebruiken.</string>
    <string name="tour_area_add_title">Punten toevoegen</string>
    <string name="tour_area_add_body">Tik op de kaart om een punt toe te voegen. Punten worden verbonden in de volgorde waarin je ze plaatst. Het gebied heeft er minstens 3 nodig.</string>
    <string name="tour_area_select_title">Selecteren en verplaatsen</string>
    <string name="tour_area_select_body">Tik op een punt om het te selecteren. Het krijgt een rode rand. Sleep het om het te verplaatsen. Tik op een lege plek op de kaart om de selectie op te heffen.</string>
    <string name="tour_area_delete_title">Punt verwijderen</string>
    <string name="tour_area_delete_body">Deze knop verwijdert het geselecteerde punt. Hij werkt zodra er een punt is geselecteerd. De rest van de omtrek blijft staan.</string>
    <string name="tour_area_erase_title">Alles wissen</string>
    <string name="tour_area_erase_body">Alles wissen verwijdert alle punten, zodat je opnieuw kunt beginnen.</string>
    <string name="tour_area_save_title">Opslaan</string>
    <string name="tour_area_save_body">Opslaan zet het gebied terug in de speelveldgegevens. Het speelveld wordt bewaard zodra je het daar opslaat. Je kunt het gebied later wijzigen door het opnieuw te openen vanuit de gegevens. Annuleren gaat terug zonder het gebied te wijzigen.</string>

    <!-- Eerste-keer-rondleiding: prooi-HUD -->
    <string name="tour_prey_role_title">Je rol</string>
    <string name="tour_prey_role_body">Je bent een prooi. Blijf verborgen tot de tijd om is. Het label knippert rood Straf zolang je een straf hebt.</string>
    <string name="tour_prey_proximity_title">Nabijheid van de jager</string>
    <string name="tour_prey_proximity_body">Hoe dichtbij de jager is. Veilig: 250 m of meer. Dichtbij: 100 tot 250 m. Waarschuwing: minder dan 100 m. Onbekend: nog geen locatie van de jager.</string>
    <string name="tour_prey_time_title">Resterende tijd</string>
    <string name="tour_prey_time_body">Hoe lang het spel nog duurt. Blijf vrij tot de tijd op nul staat.</string>
    <string name="tour_prey_distance_title">Afstand jager</string>
    <string name="tour_prey_distance_body">De afstand tot de dichtstbijzijnde jager, in de kleur van de nabijheid.</string>
    <string name="tour_prey_broadcast_title">Volgende uitzending</string>
    <string name="tour_prey_broadcast_body">Wanneer je locatie weer naar de jager wordt gestuurd. Verplaats je voordat de teller op nul staat.</string>
    <string name="tour_prey_toggle_title">Paneel verbergen</string>
    <string name="tour_prey_toggle_body">Tik hier om het paneel in te klappen en meer van de kaart te zien. Tik nog een keer om het uit te klappen.</string>

    <!-- Eerste-keer-rondleiding: jager-HUD -->
    <string name="tour_hunter_role_title">Je rol</string>
    <string name="tour_hunter_role_body">Je bent de jager. Vind de prooien en tag ze voordat de tijd om is.</string>
    <string name="tour_hunter_clock_title">Spelklok</string>
    <string name="tour_hunter_clock_body">De resterende speeltijd. Hij wordt oranje bij 10 minuten en rood bij 5 minuten. Zolang je een straf hebt, staat er rood Straf.</string>
    <string name="tour_hunter_ping_title">Volgende locatieping</string>
    <string name="tour_hunter_ping_body">Wanneer de locaties van de prooien weer op je kaart worden bijgewerkt.</string>
    <string name="tour_hunter_preys_title">Prooien in het spel</string>
    <string name="tour_hunter_preys_body">Hoeveel prooien nog vrij zijn, van alle prooien in het spel.</string>
    <string name="tour_hunter_closest_title">Dichtstbijzijnde prooi</string>
    <string name="tour_hunter_closest_body">De afstand tot de laatst bekende locatie van de dichtstbijzijnde prooi, niet tot zijn actuele positie.</string>
    <string name="tour_hunter_penalised_title">Prooien met straf</string>
    <string name="tour_hunter_penalised_body">Hoeveel prooien op dit moment een straf hebben.</string>
    <string name="tour_hunter_tag_title">Taggen</string>
    <string name="tour_hunter_tag_body">Opent de lijst met prooien binnen bereik. Alleen prooien binnen %1$d m kun je taggen. De knop is vergrendeld zolang de startvertraging van de jager loopt.</string>

    <!-- Instellingen: eerste-keer-hints -->
    <string name="settings_section_hints">Hints</string>
    <string name="settings_hints_body">Korte rondleidingen leggen de speelveldeditor en de schermen van prooi en jager uit als je ze voor het eerst ziet.</string>
    <string name="settings_hints_reset">Hints opnieuw tonen</string>
    <string name="settings_hints_reset_done">De hints worden de volgende keer weer getoond.</string>
    <string name="settings_hints_reset_failed">De hints konden niet worden teruggezet. Probeer het opnieuw.</string>
</resources>
